---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'AI 입문자와 교육자를 위한 AI 뉴스 큐레이션' } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- NAV -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-bg-cream/90 backdrop-blur-sm border-b border-main/5">
      <div class="max-w-3xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="text-xl font-bold tracking-tight">
          Re:<span class="text-accent">Frame</span>
          <span class="text-sm font-normal text-sub ml-1.5">AI 뉴스</span>
        </a>
        <div class="flex items-center gap-5 text-sm font-medium text-main/70">
          <a href="/archive" class="hover:text-accent transition">아카이브</a>
          <a href="/search" class="hover:text-accent transition">검색</a>
          <a href="https://reframe-ai.github.io" target="_blank" class="hover:text-accent transition">Re:Frame</a>
        </div>
      </div>
    </nav>

    <!-- MAIN -->
    <main class="flex-1 pt-20">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="bg-bg-dark py-12 px-6 mt-16">
      <div class="max-w-3xl mx-auto text-center">
        <a href="https://reframe-ai.github.io" class="text-white/80 font-bold text-lg hover:text-accent transition">
          Re:<span class="text-accent">Frame</span>
        </a>
        <p class="text-white/40 text-sm mt-2">AI, 어렵지 않아요. 천천히, 제대로 배우는 AI 교육.</p>
        <div class="flex justify-center gap-6 mt-4 text-sm text-white/30">
          <a href="mailto:sunryepark12@gmail.com" class="hover:text-accent transition">Email</a>
          <a href="https://www.threads.net/@slowsoyang" target="_blank" class="hover:text-accent transition">Threads</a>
        </div>
        <p class="text-white/20 text-xs mt-6">&copy; 2026 Re:Frame. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
