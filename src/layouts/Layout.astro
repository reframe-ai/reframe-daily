---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'AI 입문자와 교육자를 위한 AI 뉴스 큐레이션' } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- NAV -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-bg-cream/90 backdrop-blur-sm border-b border-main/5">
      <div class="max-w-5xl mx-auto px-6 md:px-10 py-4 flex items-center justify-between">
        <a href="/" class="text-xl font-bold tracking-tight">
          오늘의 <span class="text-accent">AI</span>
        </a>
        <div class="flex items-center gap-5 text-sm font-medium text-main/70">
          <a href="/archive" class="hover:text-accent transition">아카이브</a>
          <a href="/search" class="hover:text-accent transition">검색</a>
          <a href="https://reframe-ai.github.io" class="hover:text-accent transition">메인</a>
        </div>
      </div>
    </nav>

    <!-- MAIN -->
    <main class="flex-1 pt-20">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="bg-bg-dark py-16 px-6 mt-16">
      <div class="max-w-4xl mx-auto">
        <!-- 소개 -->
        <div class="text-center mb-10">
          <a href="https://reframe-ai.github.io" class="text-white/90 font-bold text-xl hover:text-accent transition">
            Re:<span class="text-accent">Frame</span>
          </a>
          <p class="text-white/50 text-base mt-3 leading-relaxed">
            AI, 어렵지 않아요. 천천히, 제대로 배우는 AI 교육.
          </p>
        </div>

        <!-- 운영자 소개 -->
        <div class="bg-white/5 rounded-2xl px-8 py-8 mb-10 max-w-2xl mx-auto">
          <p class="text-white/70 text-sm leading-relaxed text-center">
            <span class="text-accent font-bold">박선례</span> · AI 활용 강사 · NCS 강사<br class="md:hidden" />
            <span class="hidden md:inline"> · </span>
            전북대학교 교육대학원 평생교육 및 HRD 석사<br />
            <span class="text-white/40 mt-2 block">
              AI 입문자와 교육자를 위해 매주 2회 AI 소식을 큐레이션합니다.
            </span>
          </p>
        </div>

        <!-- 링크 -->
        <div class="flex justify-center gap-6 text-sm text-white/30">
          <a href="https://reframe-ai.github.io" class="hover:text-accent transition">메인 사이트</a>
          <a href="mailto:sunryepark12@gmail.com" class="hover:text-accent transition">Email</a>
          <a href="https://www.threads.net/@slowsoyang" target="_blank" class="hover:text-accent transition">Threads</a>
        </div>
        <p class="text-white/15 text-xs mt-8 text-center">&copy; 2026 Re:Frame. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
