---
interface Props {
  context: string;
  title: string;
  prompt: string;
  howToUse: string;
}

const { context, title, prompt, howToUse } = Astro.props;

const [basicPart, advancedPart] = howToUse.split(/한 걸음 더\s*\(중급\)\s*:\s*/);
---

<article class="py-12 border-b border-main/8 last:border-b-0">
  <div class="flex items-center gap-2 mb-5">
    <span class="bg-accent text-white text-sm font-bold px-4 py-1.5 rounded-full">{context}</span>
  </div>

  <h3 class="text-3xl font-bold text-main mb-6">{title}</h3>

  <div class="relative bg-bg-dark rounded-2xl p-8 mb-6 group">
    <pre class="text-base text-white/85 whitespace-pre-wrap leading-relaxed font-sans">{prompt}</pre>
    <button
      class="copy-btn absolute top-5 right-5 bg-white/10 hover:bg-white/20 text-white/50 hover:text-white text-sm px-4 py-2 rounded-lg transition opacity-0 group-hover:opacity-100"
      data-prompt={prompt}
    >
      복사
    </button>
  </div>

  <div class="bg-card-bg rounded-2xl px-8 py-6">
    <p class="text-sm font-bold text-sub/60 mb-3">이렇게 활용하세요</p>
    <p class="text-base text-main/70 leading-loose whitespace-pre-line">{basicPart.trim()}</p>
    {advancedPart && (
      <div class="mt-5 pt-5 border-t border-main/10">
        <p class="text-sm font-bold text-accent mb-2">🚀 한 걸음 더 (중급)</p>
        <p class="text-base text-main/70 leading-loose whitespace-pre-line">{advancedPart.trim()}</p>
      </div>
    )}
  </div>
</article>

<script>
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const text = (btn as HTMLElement).dataset.prompt || '';
      await navigator.clipboard.writeText(text);
      btn.textContent = '복사됨!';
      setTimeout(() => { btn.textContent = '복사'; }, 1500);
    });
  });
</script>
