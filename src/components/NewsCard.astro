---
interface Props {
  number: number;
  title: string;
  source: string;
  url: string;
  threeLines: string[];
  simpleExplain: string;
  whyItMatters: string;
}

const { number, title, source, url, threeLines, simpleExplain, whyItMatters } = Astro.props;
---

<article class="py-14 border-b border-main/8 last:border-b-0">
  <!-- 번호 -->
  <div class="text-8xl font-bold text-accent/10 leading-none mb-6">
    {String(number).padStart(2, '0')}
  </div>

  <!-- 제목 -->
  <h3 class="text-4xl md:text-5xl font-bold text-main leading-tight mb-10">
    {title}
  </h3>

  <!-- 핵심 3줄 -->
  <div class="mb-10">
    <p class="text-base font-bold text-sub/50 uppercase tracking-widest mb-5">핵심 3줄</p>
    <ul class="space-y-4">
      {threeLines.map(line => (
        <li class="flex items-start gap-4 text-main/80">
          <span class="w-2.5 h-2.5 rounded-full bg-accent mt-3 shrink-0"></span>
          <span class="text-xl leading-relaxed">{line}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- 쉽게 말하면 -->
  <div class="bg-accent/5 rounded-2xl px-10 py-8 mb-6">
    <p class="text-base font-bold text-accent mb-3">쉽게 말하면</p>
    <p class="text-2xl font-medium text-main leading-relaxed">"{simpleExplain}"</p>
  </div>

  <!-- 왜 중요하냐면 -->
  <div class="bg-card-bg rounded-2xl px-10 py-8 mb-8">
    <p class="text-base font-bold text-sub/60 mb-3">왜 중요하냐면</p>
    <p class="text-lg text-main/70 leading-relaxed">{whyItMatters}</p>
  </div>

  <!-- 출처 + 원문 -->
  <div class="flex items-center justify-between">
    <span class="text-base text-sub/40">{source}</span>
    <a
      href={url}
      target="_blank"
      rel="noopener"
      class="text-lg text-accent font-medium hover:text-accent/70 transition"
    >
      원문 보기 →
    </a>
  </div>
</article>
