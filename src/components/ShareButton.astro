---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
---

<div class="flex flex-col items-center gap-3 py-8">
  <button
    id="kakao-share"
    class="bg-[#FEE500] text-[#3C1E1E] px-6 py-3 rounded-full font-semibold text-sm hover:bg-[#FDD800] transition shadow-sm flex items-center gap-2"
    data-title={title}
    data-url={url}
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="#3C1E1E">
      <path d="M12 3C6.48 3 2 6.58 2 10.9c0 2.78 1.8 5.22 4.5 6.6-.2.72-.72 2.6-.82 3 0 0-.02.06.03.09.05.02.1 0 .1 0 .14-.02 1.58-1.04 2.24-1.52.62.1 1.27.14 1.95.14 5.52 0 10-3.58 10-7.9S17.52 3 12 3z"/>
    </svg>
    카카오톡 공유
  </button>

  <button
    id="link-copy"
    class="text-sub/60 text-xs hover:text-accent transition"
    data-url={url}
  >
    링크 복사
  </button>
</div>

<script>
  document.getElementById('link-copy')?.addEventListener('click', async (e) => {
    const url = (e.currentTarget as HTMLElement).dataset.url || '';
    await navigator.clipboard.writeText(url);
    (e.currentTarget as HTMLElement).textContent = '복사됨!';
    setTimeout(() => { (e.currentTarget as HTMLElement).textContent = '링크 복사'; }, 1500);
  });

  // 카카오톡 공유는 Kakao SDK 로드 후 동작
  document.getElementById('kakao-share')?.addEventListener('click', (e) => {
    const el = e.currentTarget as HTMLElement;
    const title = el.dataset.title || '';
    const url = el.dataset.url || '';

    if (typeof (window as any).Kakao !== 'undefined' && (window as any).Kakao.Share) {
      (window as any).Kakao.Share.sendDefault({
        objectType: 'feed',
        content: {
          title: title,
          description: 'Re:Frame AI 뉴스 — AI 입문자와 교육자를 위한 큐레이션',
          imageUrl: '',
          link: { mobileWebUrl: url, webUrl: url },
        },
        buttons: [{ title: '뉴스 보기', link: { mobileWebUrl: url, webUrl: url } }],
      });
    } else {
      // SDK 미로드 시 URL 복사로 폴백
      navigator.clipboard.writeText(url);
      alert('카카오톡 SDK가 로드되지 않았습니다. 링크가 복사되었습니다.');
    }
  });
</script>
