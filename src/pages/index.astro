---
import { getCollection } from 'astro:content';

const entries = (await getCollection('daily')).sort((a, b) => b.id.localeCompare(a.id));
const latest = entries[0];
const url = `/daily/${latest.id}`;
---

<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${url}`} />
    <link rel="canonical" href={url} />
    <title>오늘의 AI</title>
  </head>
  <body></body>
</html>
