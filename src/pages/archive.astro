---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const entries = (await getCollection('daily')).sort((a, b) => b.id.localeCompare(a.id));

// "핵심 — 부연" 형태의 제목에서 핵심만 남긴다
const core = (title: string) => title.split(/\s+[—–-]\s+/)[0].trim();

const headlines = (data: (typeof entries)[number]['data']) => {
  const all = [...data.tools, ...data.policy].map(n => core(n.title));
  return { lead: all[0], rest: all.slice(1) };
};
---

<Layout title="아카이브 — Re:Frame AI 뉴스">
  <div class="max-w-3xl mx-auto px-6 py-10 animate-fade-in-up">
    <header class="mb-10">
      <h1 class="text-3xl font-bold text-main mb-2">아카이브</h1>
      <p class="text-sub">지난 호를 모아볼 수 있습니다.</p>
    </header>

    <div class="space-y-4">
      {entries.map(entry => {
        const { lead, rest } = headlines(entry.data);
        const practice = entry.data.prompts[0]?.title;
        return (
          <a
            href={`/daily/${entry.id}`}
            class="block bg-white rounded-xl px-6 py-5 border border-main/5 shadow-sm hover:shadow-md hover:border-accent/20 transition-all group"
          >
            <div class="flex items-baseline justify-between mb-3">
              <div class="flex items-baseline gap-3">
                <span class="bg-accent/10 text-accent text-sm font-bold px-3 py-1 rounded-full">
                  Vol.{String(entry.data.issue).padStart(3, '0')}
                </span>
                <span class="text-xs text-sub/60 tabular-nums">{entry.data.date}</span>
              </div>
              <span class="text-accent opacity-0 group-hover:opacity-100 transition">→</span>
            </div>

            <h2 class="text-lg md:text-xl font-bold text-main leading-snug mb-3 group-hover:text-accent transition">
              {lead}
            </h2>

            <ul class="grid md:grid-cols-2 gap-x-8 gap-y-1.5 mb-4">
              {rest.map(t => (
                <li class="flex gap-2 text-[15px] leading-snug text-main/80">
                  <span class="text-accent/60 shrink-0">·</span>
                  <span>{t}</span>
                </li>
              ))}
            </ul>

            {practice && (
              <div class="flex items-center gap-2 pt-3 border-t border-main/5 text-sm">
                <span class="text-[11px] font-bold text-accent/70 uppercase tracking-widest shrink-0">실습</span>
                <span class="text-sub">{practice}</span>
              </div>
            )}
          </a>
        );
      })}
    </div>
  </div>
</Layout>
