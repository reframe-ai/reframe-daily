---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';
import PromptCard from '../../components/PromptCard.astro';
import ShareButton from '../../components/ShareButton.astro';

export async function getStaticPaths() {
  const entries = await getCollection('daily');
  return entries.map(entry => ({
    params: { date: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;

const allEntries = (await getCollection('daily')).sort((a, b) => a.id.localeCompare(b.id));
const currentIdx = allEntries.findIndex(e => e.id === entry.id);
const prev = currentIdx > 0 ? allEntries[currentIdx - 1] : null;
const next = currentIdx < allEntries.length - 1 ? allEntries[currentIdx + 1] : null;

const pageUrl = `${Astro.url.origin}/daily/${entry.id}`;
const pageTitle = `오늘의 AI Vol.${String(d.issue).padStart(3, '0')}`;

let newsNumber = 0;
---

<Layout title={`${pageTitle} · ${d.date}`}>
  <div class="max-w-4xl mx-auto px-6 md:px-10 py-14 animate-fade-in-up">

    <!-- 헤더 -->
    <header class="mb-14 pt-6 text-left md:text-center">
      <p class="text-base text-sub mb-3">
        Vol.{String(d.issue).padStart(3, '0')} · {d.date}
      </p>
      <h1 class="text-7xl md:text-8xl font-bold text-main">
        오늘의 <span class="text-accent">AI</span>
      </h1>
    </header>

    <!-- 키워드 -->
    <div class="flex flex-wrap justify-start md:justify-center gap-2.5 mb-16">
      {d.keywords.map(kw => (
        <span class="text-sm text-accent bg-accent/8 px-4 py-2 rounded-full font-medium">
          #{kw}
        </span>
      ))}
    </div>

    <!-- AI 도구 · 서비스 -->
    {d.tools.length > 0 && (
      <section class="mb-8">
        <h2 class="text-sm font-bold text-sub/40 uppercase tracking-widest mb-2 text-left md:text-center">AI 도구 · 서비스</h2>
        <div class="divide-y divide-main/8">
          {d.tools.map(item => (
            <NewsCard
              number={++newsNumber}
              title={item.title}
              source={item.source}
              url={item.url}
              threeLines={item.threeLines}
              simpleExplain={item.simpleExplain}
              whyItMatters={item.whyItMatters}
            />
          ))}
        </div>
      </section>
    )}

    <!-- AI 정책 · 윤리 -->
    {d.policy.length > 0 && (
      <section class="mb-8">
        <h2 class="text-sm font-bold text-sub/40 uppercase tracking-widest mb-2 text-left md:text-center">사회 · 교육</h2>
        <div class="divide-y divide-main/8">
          {d.policy.map(item => (
            <NewsCard
              number={++newsNumber}
              title={item.title}
              source={item.source}
              url={item.url}
              threeLines={item.threeLines}
              simpleExplain={item.simpleExplain}
              whyItMatters={item.whyItMatters}
            />
          ))}
        </div>
      </section>
    )}

    <!-- 오늘의 실습 -->
    {d.prompts.length > 0 && (
      <section class="mb-8">
        <h2 class="text-sm font-bold text-sub/40 uppercase tracking-widest mb-2 text-left md:text-center">오늘의 실습</h2>
        <div class="divide-y divide-main/8">
          {d.prompts.map(item => (
            <PromptCard
              context={item.context}
              title={item.title}
              prompt={item.prompt}
              howToUse={item.howToUse}
            />
          ))}
        </div>
      </section>
    )}

    <!-- 네비게이션 -->
    <nav class="border-t border-main/10 pt-8 mt-8 flex items-center justify-between text-sm">
      {prev ? (
        <a href={`/daily/${prev.id}`} class="text-main/50 hover:text-accent transition">
          ← Vol.{String(prev.data.issue).padStart(3, '0')}
        </a>
      ) : <span />}
      <a href="/archive" class="text-accent font-medium hover:text-accent/70 transition">아카이브</a>
      {next ? (
        <a href={`/daily/${next.id}`} class="text-main/50 hover:text-accent transition">
          Vol.{String(next.data.issue).padStart(3, '0')} →
        </a>
      ) : <span />}
    </nav>

    <!-- 공유 -->
    <ShareButton title={pageTitle} url={pageUrl} />
  </div>
</Layout>
